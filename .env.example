# Backend runtime / production database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME"
PG_POOL_MAX="3"
PGSSLMODE="require"

# Server-side auth and email config.
URBANNEX_ADMIN_EMAIL="admin@example.com"
URBANNEX_ADMIN_PASSWORD="replace-with-strong-password"
SESSION_SECRET="replace-with-random-session-secret"
JWT_SECRET="replace-with-random-jwt-secret"
APP_URL="https://your-app.vercel.app"
VERCEL_URL="your-app-git-branch-name.vercel.app"

# Email Dispatch Providers (Automated Nodemailer + Multi-Transport):
# 1. Real Gmail Delivery (Recommended for instant real inbox dispatch):
# GMAIL_USER="iamgokulvanan@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# 2. Custom SMTP:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# 3. Third-party API:
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxx"
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
AUTH_FROM_EMAIL="UrbanNex Command Center <noreply@urbannex.ai>"

# Local dev only.
SQLITE_PATH="./urbannex.db"
NODE_ENV="development"

# Frontend environment variables used by Vercel static app.
VITE_API_BASE_URL="https://your-backend.example.com"
VITE_WS_URL="wss://your-backend.example.com"
VITE_BACKEND_URL="https://your-backend.example.com"
# Vercel serverless HTTP proxy target; point this at the same persistent backend.
BACKEND_URL="https://your-backend.example.com"
DISABLE_HMR="false"

# Optional CORS override.
CORS_ORIGIN="https://urban-nex-ai.vercel.app,https://your-backend.example.com"
FRONTEND_URL="https://urban-nex-ai.vercel.app"
